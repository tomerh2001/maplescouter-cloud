{
  "name": "maplescouter-cloud",
  "version": "1.0.0",
  "description": "Cloud save backend for the MapleScouter Enhancements extension: IGN-keyed preset sync API",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "npm run build && PORT=8080 DATA_DIR=./tmp/data LOG_PRETTY=1 node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomerh2001/maplescouter-cloud.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.1",
    "ip-address": "^10.7.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
